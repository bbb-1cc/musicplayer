<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/playlistFragment">

    <fragment
        android:id="@+id/playQueueFragment"
        android:name="com.example.musicplayer.PlayQueueFragment"
        android:label="fragment_play_queue"
        tools:layout="@layout/fragment_play_queue" />
    <fragment
        android:id="@+id/playerDetailFragment"
        android:name="com.example.musicplayer.PlayerDetailFragment"
        android:label="fragment_player_detail"
        tools:layout="@layout/fragment_player_detail" />
    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.example.musicplayer.PlaylistFragment"
        android:label="fragment_playlist"
        tools:layout="@layout/fragment_playlist" >
        <action
            android:id="@+id/action_playlist_to_detail"
            app:destination="@id/playerDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.musicplayer.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
</navigation>